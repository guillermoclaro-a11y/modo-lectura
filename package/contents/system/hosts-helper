#!/bin/bash
# Modo lectura — privileged helper (runs as root through pkexec/polkit).
#
# Installed twice; the file name selects the action:
#   .../modo-lectura/block   <minutes 1-240> <domain>...
#   .../modo-lectura/unblock
#
# It only ever touches a clearly marked block inside /etc/hosts, validates
# every argument, and schedules a root-side failsafe that unblocks on its own.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin
umask 022

HOSTS=/etc/hosts
BEGIN='# >>> modo-lectura >>>'
END='# <<< modo-lectura <<<'
FAILSAFE=modo-lectura-failsafe
SELF_DIR=$(dirname "$(readlink -f "$0")")
MAX_DOMAINS=100
DOMAIN_RE='^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'

die() { echo "modo-lectura: $*" >&2; exit 2; }

remove_block() {
    if grep -qxF "$BEGIN" "$HOSTS"; then
        local content
        content=$(awk -v b="$BEGIN" -v e="$END" '$0==b{skip=1;next} $0==e{skip=0;next} !skip' "$HOSTS")
        # Rewrite in place to keep the file's owner, mode and SELinux label.
        printf '%s\n' "$content" > "$HOSTS"
    fi
}

stop_failsafe() { systemctl stop "$FAILSAFE.timer" 2>/dev/null || true; }

do_block() {
    (( $# >= 2 )) || die "usage: block <minutes 1-240> <domain>..."
    [[ "$1" =~ ^[0-9]{1,3}$ ]] || die "invalid minutes: $1"
    local min=$(( 10#$1 )); shift
    (( min >= 1 && min <= 240 )) || die "minutes must be 1-240"
    (( $# <= MAX_DOMAINS )) || die "too many domains (max $MAX_DOMAINS)"

    local -a hosts=()
    local d
    for d in "$@"; do
        [[ ${#d} -le 253 && "$d" =~ $DOMAIN_RE ]] || die "invalid domain: $d"
        hosts+=("$d")
        [[ "$d" == www.* ]] || hosts+=("www.$d")
    done

    remove_block
    [[ -s $HOSTS && -n $(tail -c1 "$HOSTS") ]] && echo >> "$HOSTS"
    {
        echo "$BEGIN"
        printf '%s\n' "${hosts[@]}" | sort -u | while read -r h; do
            echo "0.0.0.0 $h"
            echo ":: $h"
        done
        echo "$END"
    } >> "$HOSTS"

    # Failsafe: unblock as root even if the user session disappears.
    stop_failsafe
    systemctl reset-failed "$FAILSAFE.timer" "$FAILSAFE.service" 2>/dev/null || true
    systemd-run --quiet --unit="$FAILSAFE" --on-active="$(( min + 2 ))m" "$SELF_DIR/unblock"
}

do_unblock() {
    (( $# == 0 )) || die "usage: unblock"
    remove_block
    stop_failsafe
}

case "$(basename "$0")" in
    block)   do_block "$@" ;;
    unblock) do_unblock "$@" ;;
    *)       die "must be installed as 'block' or 'unblock'" ;;
esac
